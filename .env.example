# App
NEXT_PUBLIC_APP_URL=http://localhost:43145
NODE_ENV=development

# Auth.js / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:43145

# Optional OAuth providers (leave empty to keep credentials-only sign-in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prepharbor

# Razorpay (use test keys first: rzp_test_… from the Razorpay Dashboard)
# Never commit real secrets. The secret key is server-only and is never sent to the browser.
# The checkout page receives only RAZORPAY_KEY_ID after a signed-in order is created.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

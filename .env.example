# App
NEXT_PUBLIC_APP_URL=http://localhost:43145
NODE_ENV=development

# Auth.js / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:43145

# Optional OAuth providers (leave empty to keep credentials-only sign-in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prepharbor

# Razorpay (Indian payments). Checkout is stubbed until these are set.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
